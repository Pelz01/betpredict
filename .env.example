# BetPredict - Environment Variables

# API-Football (Soccer data, fixtures, odds)
# Get your key at: https://www.api-football.com/
VITE_API_FOOTBALL_KEY=your_api_football_key_here

# Sportmonks API (Soccer data + odds)
# Get your key at: https://www.sportmonks.com/
VITE_SPORTMONKS_API_KEY=your_sportmonks_api_key_here

# OpenRouter API (AI predictions)
# Get your key at: https://openrouter.ai/
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model
VITE_OPENROUTER_MODEL=xiaomi/mimo-v2-flash:free
